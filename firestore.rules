rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ตรวจสอบสิทธิ์ผู้ดูแลระบบ (Admin)
    function isAdmin() {
      return request.auth != null;
    }

    // ตรวจสอบความถูกต้องของการตัดสต็อกเมื่อผู้ใช้ทั่วไปยื่นคำขอยืม
    // อนุญาตให้อัปเดตได้เฉพาะจำนวนคงเหลือ (quantity) เท่านั้น โดยค่าใหม่ต้องเป็นตัวเลข >= 0 และลดลงจากเดิม
    function isValidStockDecrement() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(['quantity']) &&
             request.resource.data.quantity is number &&
             request.resource.data.quantity >= 0 &&
             request.resource.data.quantity < resource.data.quantity;
    }

    // ตรวจสอบความถูกต้องของคำขอยืมใหม่ ป้องกันการปลอมแปลงสถานะและข้อมูล
    function isValidNewBorrowRequest() {
      let data = request.resource.data;
      
      return 
        // 1. สถานะคำขอใหม่ต้องเป็น 'pending' เท่านั้น (ห้ามปลอมแปลงเป็น approved หรือ returned มาล่วงหน้า)
        data.status == 'pending' &&
        
        // 2. ชื่อผู้ยืมต้องเป็นข้อความยาว 2 - 150 ตัวอักษร
        data.borrowerName is string &&
        data.borrowerName.size() >= 2 &&
        data.borrowerName.size() <= 150 &&
        
        // 3. เบอร์โทรศัพท์ต้องเป็นข้อความความยาว 9 - 20 ตัวอักษร
        data.phone is string &&
        data.phone.size() >= 9 &&
        data.phone.size() <= 20 &&
        
        // 4. ต้องมีรายการครุภัณฑ์
        (
          ('items' in data && data.items is list && data.items.size() > 0) ||
          ('equipmentId' in data && data.equipmentId is string && data.equipmentId.size() > 0)
        ) &&

        // 5. วันที่ยืมและกำหนดคืนต้องมีระบุ
        data.borrowDate != null &&
        data.returnDate != null &&

        // 6. ห้ามมีการแนบฟิลด์ที่สงวนไว้สำหรับ Admin ตอนสร้างคำขอใหม่
        (!('returnedReceiverName' in data) || data.returnedReceiverName == null) &&
        (!('approvedDate' in data) || data.approvedDate == null) &&
        (!('returnedDate' in data) || data.returnedDate == null) &&
        (!('rejectedDate' in data) || data.rejectedDate == null) &&
        (!('rejectReason' in data) || data.rejectReason == null);
    }

    // คลังครุภัณฑ์: ทุกคนดูได้, Admin จัดการได้ทั้งหมด, ผู้ใช้ทั่วไปตัดสต็อก (quantity) ได้เมื่อส่งคำขอยืม
    match /equipments/{equipmentId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidStockDecrement();
    }
    
    // รายการคำขอยืม:
    // - อ่านได้ (สำหรับค้นหาและตรวจสอบสถานะการยืมของตนเอง)
    // - ยื่นคำขอใหม่ได้ แต่ต้องผ่านการตรวจสอบโครงสร้างข้อมูลอย่างเข้มงวด (Data Schema Validation)
    // - แก้ไข/อนุมัติ/รับคืน/ลบ ได้เฉพาะ Admin ที่ล็อกอินแล้วเท่านั้น
    match /borrowRequests/{requestId} {
      allow read: if true;
      allow create: if isValidNewBorrowRequest();
      allow update, delete: if isAdmin();
    }
  }
}
